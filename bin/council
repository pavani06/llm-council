#!/usr/bin/env bash
# Prefere o venv do projeto (onde vive o SDK anthropic); cai no python do sistema
# se ele nao existir — os outros tres provedores nao precisam de dependencia.
# readlink -f resolve o symlink: sem isso, um link em ~/.local/bin faz `here`
# apontar para ~/.local, que nao tem venv nem o pacote.
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
py="$here/.venv/bin/python"
[ -x "$py" ] || py="python3"
cd "$here" && exec "$py" -m council "$@"
