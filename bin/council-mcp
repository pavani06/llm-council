#!/usr/bin/env bash
# Launcher do servidor MCP: garante cwd e interpretador certos, venha de onde vier.
# readlink -f resolve o symlink: sem isso, um link em ~/.local/bin faz `here`
# apontar para ~/.local, que nao tem venv nem o pacote.
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
py="$here/.venv/bin/python"
[ -x "$py" ] || py="python3"
cd "$here" && exec "$py" -m council.mcp_server "$@"
